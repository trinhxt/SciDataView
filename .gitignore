# ==============================================================================
# SciDataView - Git Ignore Rules
# ==============================================================================

# Embedded Portable R Runtime (Large Windows binaries: ~200MB)
app/R-Portable/
R-Portable/

# Local Compiled R Package Libraries (~150MB)
app/library/
library/

# WebAssembly / Shinylive build artifacts (Auto-generated by export_shinylive.R)
dist_web/
shinylive/

# R session data, history and cache
.Rhistory
.RData
.RDataTmp
.Rproj.user/
.Rcache/

# Temporary test data & generated reports
scratch/
*.html
*.txt
!README.txt
*.csv.tmp
*.parquet.tmp

# Distribution archives & releases
*.zip
*.tar.gz
*.7z

# Operating System temporary files
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/
.DS_Store

#
*.lnk
